import time

def countdown_timer(seconds):
    while seconds:
        mins, secs = divmod(seconds, 60)
        timer = f'{mins:02d}:{secs:02d}' 
        print(timer, end="\r")  
        time.sleep(1) 
        seconds -= 1
    print("Finished!")  

if __name__ == "__main__":
    seconds_input = int(input("lenght of the timer (seconds): "))
    countdown_timer(seconds_input)
